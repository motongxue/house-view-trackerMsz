{
  "manifest_version": 3,
  "name": "择隅 · 房源采集",
  "version": "1.5.0",
  "description": "在安居客楼盘页、贝壳二手房详情页自动采集房源信息，导出为择隅系统可直接导入的 CSV，或一键推送到本机 / 远程择隅系统。",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "downloads"],
  "host_permissions": [
    "https://m.anjuke.com/*",
    "https://*.ke.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "择隅采集"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.anjuke.com/*/loupan/*",
        "https://*.ke.com/ershoufang/*.html"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8787/*",
        "http://localhost:8787/*"
      ],
      "js": ["system-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
