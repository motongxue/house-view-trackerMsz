# ============================================================
# 数据库（PostgreSQL）—— 只在不用内嵌库时生效
# 用法：HVT_DB=embedded 时改用内嵌库，下面这些全部忽略；
#       连外部 PostgreSQL 时，PGPASSWORD 必须填，且代码里没有默认口令。
# 生产部署：口令由部署脚本随机生成后写入 .env，不要手抄到代码或文档里。
# 本地开发：填你本机 PostgreSQL 里 hvt 角色的口令即可。
# ============================================================
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=hvt
PGPASSWORD=
PGDATABASE=house_view

# ============================================================
# 敏感字段加密主密钥（可选）
# 用户自己填的第三方 API Key 会以 AES-256-GCM 密文存进数据库，主密钥来源二选一：
#   1) 这里填 HVT_SECRET（任意长口令，内部 sha256 成 32 字节）；
#   2) 留空 —— 首次启动会在 data/ 下自动生成 .secret.key（权限 0600）。
# 注意：无论用哪种，都要跟 data 目录一起备份。换了密钥或丢了文件，
#       已保存的 API Key 就解不开了，需要到设置页重新填一次（数据本身不会丢）。
# ============================================================
HVT_SECRET=

# ============================================================
# freellmapi（本地免费 LLM 聚合网关）配置模板
# 用法：把本文件复制为 .env，并填好下面的 FREELLM_API_KEY
#   cp .env.example .env
#
# 说明：
#   - FREELLM_BASE_URL 默认是 freellmapi 桌面版的 31415 端口；
#     若你用的是源码/Docker 版（默认 3001），或改过端口，请相应调整，且路径保留 /v1
#   - FREELLM_API_KEY 是你在 freellmapi 仪表盘 Keys 页面顶部拿到的「统一令牌」（freellmapi-... 开头）
#   - 本文件是模板（不含真实密钥），应随代码提交；复制出来的 .env 才含真实凭据，
#     且已被 .gitignore 忽略，切勿提交或随部署包分发
# ============================================================
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=

# ============================================================
# 邮箱验证码总开关（默认 false，开箱即用）——
# false：注册只需邮箱 + 密码 + 图形验证码，不需要发邮件；
#        未配 SMTP 也能正常注册/登录。「验证码登录/找回密码」会自动隐藏并禁用。
# true ：注册/验证码登录/找回密码都走邮件验证，必须配好下方 SMTP，否则相关操作明确报错。
# 建议：本地/内网/自托管保持 false；挂公网对外开放再改 true（这是主流自托管项目的做法）。
# ============================================================
EMAIL_VERIFICATION=false

# ============================================================
# 邮件服务（SMTP）—— 仅当 EMAIL_VERIFICATION=true 时才需要配置
# HOST / USER / PASS / FROM 四项都填齐才生效。
# 未配置且开关为 true 时，相关操作会明确报「系统尚未配置邮件服务」，绝不静默跳过验证。
# ------------------------------------------------------------
# QQ 邮箱：SMTP_HOST=smtp.qq.com，端口 465；SMTP_PASS 填「授权码」而不是 QQ 登录密码，
#          在 QQ 邮箱 设置 → 账号 → POP3/SMTP 服务 里开启后生成 16 位授权码。
# 163 邮箱：SMTP_HOST=smtp.163.com，端口 465，同样用授权码。
# 587 端口（部分企业邮箱）：设 SMTP_SECURE=false，客户端会自动 STARTTLS 升级。
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=看房记录工具

# 仅本地开发用：不连 SMTP，把验证码打印在服务端控制台，方便先跑通全流程。
# 生产环境务必删掉这行或保持 false，否则等于绕过邮件验证。
EMAIL_DEV_LOG=false

# ============================================================
# 运行监控：管理员（设置 → 运行监控 里可切换「我的 / 全部」视图）
# 只有这里列出的邮箱能看到全部用户的登录日志与模型流量；未配置则所有账号只能看自己。
# 多个邮箱用逗号分隔，改完需重启后端（node server.js）。
# 日志默认保留 90 天；不记录密码、验证码、令牌、提问正文与图片。
# ============================================================
ADMIN_EMAILS=

# ============================================================
# 登录风控排查（一般不用开）
# 设为 1 后，每次密码登录都会在控制台打印一行 [RISK][login] score=... [命中项]，
# 用来查「为什么这个人被要求做验证码」。打印内容只有分数与信号名，不含邮箱密码。
# 分数 < 60 才要求验证码；同一 IP / 同一邮箱近期失败满 3 次则无条件要求验证码。
# ============================================================
HVT_DEBUG_RISK=

# ============================================================
# 反代 / HTTPS（v2.0.0）—— 现在用 IP+8787 直连就全部留空，别动
# 买好域名、备案通过、装好 Caddy 之后再按 deploy/Caddyfile.example 开启：
#   HVT_BIND=127.0.0.1          只监听本机，云安全组同时关掉 8787 公网入口
#   HVT_TRUST_PROXY=1           只在请求来自本机/内网时才采信 X-Forwarded-For 与 -Proto
#   HVT_TRUST_PROXY_NETS=...    可信代理网段，默认 127.0.0.1,::1 及三个内网段
#   HVT_REQUIRE_HTTPS=1         非 HTTPS 请求一律 426，杜绝明文令牌
#   HVT_PUBLIC_HOST=你的域名    仅用于启动日志显示
# ============================================================
HVT_BIND=
HVT_TRUST_PROXY=
HVT_REQUIRE_HTTPS=
HVT_PUBLIC_HOST=

# ============================================================
# 升级包验签（v2.0.0）
# 信任根放在 data/trust/pubkey.pem，由程序包的 trust/pubkey.pem 首次启动时复制，之后永不覆盖。
# 如要轮换密钥：本机跑 node scripts/sign-release.js --gen-key <新私钥路径>，
# 然后把新 trust/pubkey.pem 连同新包一起部署，并人工上服务器替换 data/trust/pubkey.pem。
# HVT_RELEASE_HOSTS 可追加自建发布域名（逗号分隔）；默认只允许 gitee/github/jsdelivr。
# ============================================================
HVT_RELEASE_HOSTS=
