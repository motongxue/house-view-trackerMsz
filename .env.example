# ============================================================
# freellmapi（本地免费 LLM 聚合网关）配置模板
# 用法：把本文件复制为 .env，并填好下面的 FREELLM_API_KEY
#   cp .env.example .env
#
# 说明：
#   - FREELLM_BASE_URL 默认是 freellmapi 桌面版的 31415 端口；
#     若你用的是源码/Docker 版（默认 3001），或改过端口，请相应调整，且路径保留 /v1
#   - FREELLM_API_KEY 是你在 freellmapi 仪表盘 Keys 页面顶部拿到的「统一令牌」（freellmapi-... 开头）
#   - 本文件是模板（不含真实密钥），应随代码提交；复制出来的 .env 才含真实凭据，
#     且已被 .gitignore 忽略，切勿提交或随部署包分发
# ============================================================
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=

# ============================================================
# 邮件服务（SMTP）—— 注册 / 登录 / 找回密码的邮箱验证码
# 部署给别人用之前必须配好；HOST / USER / PASS / FROM 四项都填齐才生效。
# 未配置时相关操作会明确报「系统尚未配置邮件服务」，绝不静默跳过验证。
# ------------------------------------------------------------
# QQ 邮箱：SMTP_HOST=smtp.qq.com，端口 465；SMTP_PASS 填「授权码」而不是 QQ 登录密码，
#          在 QQ 邮箱 设置 → 账号 → POP3/SMTP 服务 里开启后生成 16 位授权码。
# 163 邮箱：SMTP_HOST=smtp.163.com，端口 465，同样用授权码。
# 587 端口（部分企业邮箱）：设 SMTP_SECURE=false，客户端会自动 STARTTLS 升级。
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=看房记录工具

# 仅本地开发用：不连 SMTP，把验证码打印在服务端控制台，方便先跑通全流程。
# 生产环境务必删掉这行或保持 false，否则等于绕过邮件验证。
EMAIL_DEV_LOG=false
